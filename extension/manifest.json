{
  "manifest_version": 3,
  "name": "ClipVora - Media Downloader",
  "version": "1.0",
  "description": "Download videos and audio from various platforms via ClipVora.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "https://clipvora.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
